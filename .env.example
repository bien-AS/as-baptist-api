# Local development defaults. Do not put real credentials in this file.
APP_ENV=local
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# The running API uses the RLS-enforced app_api role.
DATABASE_URL=postgresql+asyncpg://app_api:change-me@localhost:5432/baptist
# Alembic uses a separate migrator connection and is never used by the API process.
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://app_migrator:change-me@localhost:5432/baptist

CORS_ORIGINS=http://localhost:5173
AUTH_MODE=mock
SUPABASE_JWKS_URL=
